# Repo2Resume — server-side keys (used by /api functions on Vercel and by `npm run dev`)
# These are NOT prefixed with VITE_, so they never reach the browser bundle.
# On Vercel, set them under Project Settings -> Environment Variables.

# Gemini key for AI bullets when a visitor hasn't added their own.
# Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional GitHub token (no scopes needed for public data). Raises the shared
# GitHub API limit from 60 to 5,000 requests/hour for all visitors.
GITHUB_TOKEN=
